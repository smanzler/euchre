{
  "name": "euchre",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "start": "pnpm --filter @euchre/mobile start",
    "ios": "pnpm --filter @euchre/mobile ios",
    "android": "pnpm --filter @euchre/mobile android",
    "server": "pnpm --filter @euchre/server dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "lint-staged": {
    "apps/mobile/**/*.{js,jsx,ts,tsx}": "pnpm --filter @euchre/mobile exec eslint --fix",
    "packages/**/*.{js,jsx,ts,tsx,mjs,mts,cjs,cts}": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@11.23.0",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.62.0"
  }
}
